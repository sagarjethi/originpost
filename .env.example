NODE_ENV=development

# Web and API
WEB_PORT=3000
API_PORT=4000
# Server-only upstream used by the Next.js /v1 and /public/v1 rewrites.
# Set this before `next build`; Docker Compose embeds http://api:4000 in the web image.
ORIGINPOST_API_UPSTREAM=http://127.0.0.1:4000
API_PUBLIC_URL=http://localhost:4000
WEB_PUBLIC_URL=http://localhost:3000
CORS_ORIGIN=http://localhost:3000
REVIEW_LINK_SECRET=replace-with-at-least-32-random-characters
# HMAC secret for temporary provider-only media delivery links. Use a different 32+ byte value.
MEDIA_DELIVERY_SECRET=replace-with-a-separate-32-byte-random-secret
# Unfinished uploads expire after this lease. Trash is recoverable until retention ends.
MEDIA_UPLOAD_LEASE_MINUTES=60
MEDIA_TRASH_RETENTION_DAYS=7
MEDIA_CLEANUP_INTERVAL_MINUTES=15
MEDIA_CLEANUP_ENABLED=true
MEDIA_FFPROBE_PATH=ffprobe
MEDIA_INSPECTION_TIMEOUT_MS=15000
# Uploaded bytes are streamed to clamd before an asset can become ready. Disabled is safe only while live publishing is off.
MEDIA_MALWARE_SCAN_MODE=disabled
MEDIA_CLAMAV_HOST=127.0.0.1
MEDIA_CLAMAV_PORT=63310
# Optional loopback-only host port for health checks and the real-engine integration test.
MEDIA_CLAMAV_HOST_PORT=63310
MEDIA_CLAMAV_SIGNATURE_MAX_AGE_HOURS=48
MEDIA_MALWARE_SCAN_TIMEOUT_MS=120000
MEDIA_MALWARE_SCAN_MAX_BYTES=536870912
# Signed lifecycle webhooks. Keep private destinations blocked unless a trusted local n8n deployment needs them.
AUTOMATION_DELIVERY_ENABLED=true
AUTOMATION_DELIVERY_INTERVAL_SECONDS=5
AUTOMATION_ALLOW_PRIVATE_WEBHOOKS=false
# Internal owner/manager health checks and transition-based action-center alerts.
OPERATIONS_HEALTH_ENABLED=true
OPERATIONS_HEALTH_INTERVAL_MINUTES=5
OPERATIONS_PUBLISH_STALE_MINUTES=30
OPERATIONS_OUTBOX_STALE_MINUTES=15

# Local single-user mode. Use only on a trusted machine or private network.
# Official or live publishing refuses to start until this is changed to sessions.
AUTH_MODE=single-user
BOOTSTRAP_USER_ID=local-owner
BOOTSTRAP_USER_NAME=Local Owner

# Set AUTH_MODE=sessions for self-hosted multi-user login. Change the bootstrap password before first start.
BOOTSTRAP_ADMIN_EMAIL=owner@example.com
BOOTSTRAP_ADMIN_NAME=OriginPost Owner
BOOTSTRAP_ADMIN_PASSWORD=replace-with-a-strong-password
AUTH_SESSION_DAYS=14
# Use true behind HTTPS. Local HTTP testing may set false.
AUTH_COOKIE_SECURE=false

# Optional OpenID Connect login. This works only with AUTH_MODE=sessions.
# Register this exact callback URL with the identity provider. Production URLs must use HTTPS.
OIDC_ENABLED=false
OIDC_DISPLAY_NAME=Company SSO
OIDC_ISSUER_URL=
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=
OIDC_REDIRECT_URI=http://localhost:4000/v1/auth/oidc/callback
OIDC_WEB_RETURN_URL=http://localhost:3000/
OIDC_SCOPES=
OIDC_GROUPS_CLAIM=groups
# Comma-separated policy values. Empty lists do not restrict access.
OIDC_ALLOWED_EMAIL_DOMAINS=
OIDC_ALLOWED_GROUPS=
OIDC_OWNER_GROUPS=
OIDC_MANAGER_GROUPS=
OIDC_CREATOR_GROUPS=
# Existing users keep their current memberships. New users are denied unless auto-provisioning is enabled.
OIDC_AUTO_PROVISION=false
OIDC_DEFAULT_WORKSPACE_ID=default
OIDC_DEFAULT_ROLE=viewer

# 32 random bytes encoded as base64. Required before OAuth tokens can be stored.
# Example generator: openssl rand -base64 32
CREDENTIAL_ENCRYPTION_KEY=
# Comma-separated version:key entries. Keep retired versions configured until
# grants created with them have been reauthorized or deleted.
PROVIDER_LOOKUP_HMAC_KEYS=
PROVIDER_LOOKUP_HMAC_ACTIVE_VERSION=
PROVIDER_DELETION_STATUS_KEY=

# Private messages stay disabled unless a mode and both independent storage keys are configured.
# `mock` is for local/test use only and is rejected when NODE_ENV=production. `official` is a separate Meta re-consent path.
# Generate each key separately with: openssl rand -base64 32
PRIVATE_MESSAGE_CONNECTOR_MODE=disabled
PRIVATE_MESSAGE_ENCRYPTION_KEY=
PRIVATE_MESSAGE_HASH_KEY=
# Required only for `official`: lowercase SHA-256 of the operator's immutable Meta App Review approval evidence.
# Keep the evidence itself outside this repository. Re-consent binds every account grant to this reference.
META_PRIVATE_MESSAGING_APP_REVIEW_SHA256=

# Infrastructure
DATABASE_URL=postgres://originpost:originpost@localhost:65432/originpost
REDIS_URL=redis://localhost:63879
S3_ENDPOINT=http://localhost:60900
# URL a user's browser can reach. It may differ from S3_ENDPOINT when the API
# talks to object storage over a private Docker or cluster network.
S3_PUBLIC_ENDPOINT=http://localhost:60900
S3_REGION=us-east-1
S3_BUCKET=originpost-media
S3_ACCESS_KEY=originpost
S3_SECRET_KEY=change-this-secret

# Connector safety: each network is enabled separately. `CONNECTOR_MODE` remains the Instagram fallback for older installs.
CONNECTOR_MODE=mock
INSTAGRAM_CONNECTOR_MODE=mock
FACEBOOK_CONNECTOR_MODE=mock
# Facebook analytics is an independent, fail-closed read capability. `official`
# requires the official Page connector, Meta App Review evidence for read_insights,
# and a current <=30-day externally watched owned-Page probe result digest for the exact pinned Graph version.
FACEBOOK_ANALYTICS_CONNECTOR_MODE=disabled
FACEBOOK_ANALYTICS_APP_REVIEW_SHA256=
FACEBOOK_ANALYTICS_CONTRACT_PROBE_API_VERSION=
FACEBOOK_ANALYTICS_CONTRACT_PROBE_RESULT_SHA256=
FACEBOOK_ANALYTICS_CONTRACT_PROBE_VERIFIED_AT=
FACEBOOK_ANALYTICS_CONTRACT_PROBE_EXPIRES_AT=
YOUTUBE_CONNECTOR_MODE=mock
ALLOW_LIVE_PUBLISH=false
META_GRAPH_API_VERSION=
# Keep false until Google/YouTube completes the API compliance audit. Unverified projects are private-only.
YOUTUBE_API_COMPLIANCE_AUDITED=false
YOUTUBE_ALLOW_NON_PRIVATE_PUBLISHING=false

# Optional AI/search providers. Bring your own keys.
AGENT_MODE=mock
# Keep false for hosted endpoints. Enable only when the deployment owner intentionally
# connects Ollama or another trusted OpenAI-compatible service on a private network.
AGENT_ALLOW_PRIVATE_ENDPOINTS=false
PLUGIN_DIRECTORY=plugins
OPENAI_API_KEY=
# ChatGPT/GPT Image generation is internal to Creative Studio and opt-in so a
# browser click cannot incur provider cost until the operator enables it.
IMAGE_GENERATION_MODE=disabled
OPENAI_IMAGE_API_KEY=
OPENAI_IMAGE_MODEL=gpt-image-2.5-sunburst
OPENAI_IMAGE_TIMEOUT_MS=180000
EXA_API_KEY=
HERMES_API_URL=http://127.0.0.1:8642
HERMES_API_KEY=
HERMES_MODEL=hermes-agent

# First-party Board plugin. This is separate from AGENT_MODE and the discovery-only third-party catalog.
# It stays off until Hermes Agent 0.21.2 is installed, its dashboard and multiplexed API gateway are running,
# and session auth plus PostgreSQL/Redis are enabled. Generate both secrets independently.
HERMES_BOARD_PLUGIN_ENABLED=false
HERMES_BOARD_SUPPORTED_VERSION=0.21.2
HERMES_BOARD_SECRET=
HERMES_DASHBOARD_URL=http://127.0.0.1:9119
# Set the exact same value as ORIGINPOST_BOARD_PLUGIN_TOKEN in the Hermes dashboard process.
HERMES_DASHBOARD_SESSION_TOKEN=
# Exact provider/model written into and attested for every dedicated Board profile.
HERMES_BOARD_PRIMARY_PROVIDER=openai-codex
HERMES_BOARD_PRIMARY_MODEL=gpt-5.5
# Comma-separated, preinstalled Hermes skills reviewed and approved by the deployment operator.
HERMES_BOARD_APPROVED_SKILLS=
# Enable only for an intentionally trusted private Docker/host network using HTTP.
HERMES_BOARD_ALLOW_PRIVATE_ENDPOINTS=false

# Optional platform credentials. Keep empty until the connector is approved.
META_APP_ID=
META_APP_SECRET=
META_PROVIDER_CALLBACKS_ENABLED=false
META_DEAUTH_CALLBACK_CONTRACT_PROBE_SHA256=
# Facebook Login discovery for collaborator-capable Instagram accounts uses the pinned META_GRAPH_API_VERSION above.
# Register the exact callback: ${API_PUBLIC_URL}/v1/channels/oauth/instagram-facebook/callback
# Official Facebook Page Messenger and Page-linked Instagram DMs use a distinct explicit re-consent callback:
# ${API_PUBLIC_URL}/v1/channels/oauth/meta-messaging/callback
# Requested/granted scopes are fixed in server code and cannot be overridden from the browser or environment.
# Leave all three empty until collaborator publishing passes a watched probe on the exact pinned Graph version.
INSTAGRAM_COLLABORATOR_CONTRACT_PROBE_API_VERSION=
INSTAGRAM_COLLABORATOR_CONTRACT_PROBE_VERIFIED_AT=
INSTAGRAM_COLLABORATOR_CONTRACT_PROBE_EXPIRES_AT=
# Separate constant-time verification token used only for the public Meta webhook challenge.
META_WEBHOOK_VERIFY_TOKEN=
# Optional Facebook-only challenge token. Falls back to META_WEBHOOK_VERIFY_TOKEN when empty.
META_FACEBOOK_WEBHOOK_VERIFY_TOKEN=
# Leave both empty until the pinned Graph version has passed a watched Page-comment reply probe.
FACEBOOK_COMMENT_REPLY_CONTRACT_PROBE_API_VERSION=
FACEBOOK_COMMENT_REPLY_CONTRACT_PROBE_VERIFIED_AT=
FACEBOOK_PAGE_DELETE_CONTRACT_PROBE_API_VERSION=
FACEBOOK_PAGE_DELETE_CONTRACT_PROBE_VERIFIED_AT=
FACEBOOK_PAGE_DELETE_CONTRACT_PROBE_EXPIRES_AT=
FACEBOOK_PAGE_DELETE_CONTRACT_PROBE_ACCOUNT_ID=
FACEBOOK_PAGE_DELETE_CONTRACT_PROBE_EXTERNAL_PAGE_ID=
FACEBOOK_PAGE_DELETE_CONTRACT_PROBE_CREDENTIAL_VERSION=
FACEBOOK_PAGE_DELETE_CONTRACT_PROBE_ACCOUNT_VERSION=
FACEBOOK_PAGE_DELETE_CONTRACT_PROBE_PAGE_TASKS_SHA256=
FACEBOOK_COMMENT_RECONCILE_MAX_PAGES=10
# Optional override when Meta supplies a custom Business Login authorization URL.
META_INSTAGRAM_AUTHORIZATION_URL=https://www.instagram.com/oauth/authorize
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Optional Telegram command adapter. It refuses to start without an allow-list.
ORIGINPOST_API_URL=http://127.0.0.1:4000
TELEGRAM_BOT_TOKEN=
TELEGRAM_ALLOWED_CHAT_IDS=
TELEGRAM_WORKSPACE_ID=default
